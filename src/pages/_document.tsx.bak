import Document, { Html, Head, Main, NextScript } from 'next/document'

class MyDocument extends Document {
  render() {
    const nextInlineScriptSource = NextScript.getInlineScriptSource;
    NextScript.getInlineScriptSource = (props: any) => {
      let pageModelObject = JSON.stringify(props['__NEXT_DATA__'].props?.pageProps?.page)
      pageModelObject = pageModelObject?.replace(/\/page\//g, 'page/');
      pageModelObject = pageModelObject && JSON.parse(pageModelObject);

      props['__NEXT_DATA__'].props.pageProps.page = pageModelObject;
      return nextInlineScriptSource(props);
    };

    return (
      <Html>
        <Head />
        <body>
          <Main />
          <NextScript />
        </body>
      </Html>
    );
  }
}

export default MyDocument
